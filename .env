# ============================================
# ERPNext — Production Environment Variables
# ============================================
# Replace ALL placeholder passwords with strong unique secrets
# before deploying to production.

# --- Immutable application image (REQUIRED) ---
# Set to the prebuilt + pushed image reference, ideally with @sha256 digest.
# Build once with:  docker build -t ${APP_IMAGE} . && docker push ${APP_IMAGE}
# Example: APP_IMAGE=registry.example.com/erpnext:v1.0@sha256:abc123...
APP_IMAGE=your-registry/erpnext:tag@sha256:replace-me

# --- Database MariaDB ---
DB_ROOT_PASSWORD=cambiaEstaRootPassword123!
DB_NAME=erpnext
DB_USER=erpnext
DB_PASSWORD=cambiaEstaUserPassword456!

# --- ERPNext Site ---
# Domain where the app will be served
SITE_NAME=erp.saharapro.team
# Administrator user password
ADMIN_PASSWORD=cambiaEstaAdminPassword789!

# --- Production ---
# Number of gunicorn workers (adjust to available CPUs)
GUNICORN_WORKERS=4
